pub fn general_category(cp: Char32) -> i32 {
    auto low# = 0:usize
    auto high# = GENERAL_CATEGORY_RANGES_COUNT:usize
    loop low < high {
        auto middle = low + ((high - low) / 2:usize)
        auto range = GENERAL_CATEGORY_RANGES[middle]
        if cp < range.start {
            high = middle
        } else if cp > range.end {
            low = middle + 1:usize
        } else {
            return range.kind
        }
    }
    return GENERAL_CATEGORY_UNASSIGNED
}

pub fn script(cp: Char32) -> i32 {
    auto low# = 0:usize
    auto high# = SCRIPT_RANGES_COUNT:usize
    loop low < high {
        auto middle = low + ((high - low) / 2:usize)
        auto range = SCRIPT_RANGES[middle]
        if cp < range.start {
            high = middle
        } else if cp > range.end {
            low = middle + 1:usize
        } else {
            return range.kind
        }
    }
    return SCRIPT_UNKNOWN
}

pub fn is_alphabetic(cp: Char32) -> bool {
    auto low# = 0:usize
    auto high# = IS_ALPHABETIC_RANGES_COUNT:usize
    loop low < high {
        auto middle = low + ((high - low) / 2:usize)
        auto range = IS_ALPHABETIC_RANGES[middle]
        if cp < range.start {
            high = middle
        } else if cp > range.end {
            low = middle + 1:usize
        } else {
            return true
        }
    }
    return false
}

